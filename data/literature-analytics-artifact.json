  "sources": [
    {
      "id": "literature-catalog",
      "label": "手机定位数据知识库：去重文献与出版物分类",
      "href": "https://yecao02.github.io/Mobile-phone-location-reasearch/data/literature-statistics.json",
      "path": "data/literature-statistics.json",
      "query": {
        "sql": "WITH scopes AS (SELECT DISTINCT scope FROM scope_members)\nSELECT s.scope, CAST(y.year AS TEXT)||'年' AS year, COUNT(l.id) AS papers,\n SUM(COUNT(l.id)) OVER(PARTITION BY s.scope) AS denominator,\n CASE WHEN y.year=2026 THEN '截至2026年10月13日收录' ELSE '' END AS note\nFROM scopes s CROSS JOIN years y\nLEFT JOIN scope_members m ON m.scope=s.scope\nLEFT JOIN literature l ON l.id=m.id AND l.year=y.year AND l.publication_type!='conference_abstract'\nGROUP BY s.scope,y.year ORDER BY s.scope,y.year;\n\nWITH scopes AS (SELECT DISTINCT scope FROM scope_members)\nSELECT s.scope,d.domain,COUNT(l.id) AS papers,\n 1.0*COUNT(l.id)/SUM(COUNT(l.id)) OVER(PARTITION BY s.scope) AS share,\n SUM(COUNT(l.id)) OVER(PARTITION BY s.scope) AS denominator\nFROM scopes s CROSS JOIN domains d\nLEFT JOIN scope_members m ON m.scope=s.scope\nLEFT JOIN literature l ON l.id=m.id AND l.journal_domain=d.domain AND l.publication_type='journal_article'\nGROUP BY s.scope,d.domain,d.rank ORDER BY s.scope,d.rank;",
        "description": "从公开literature_catalog.json导入literature、从literature-statistics.json导入scope_members和domains，SQLite聚合后与独立审核数量逐项核对。",
        "engine": "SQLite",
        "language": "sql",
        "tables_used": [
          "literature",
          "scope_members",
          "years",
          "domains"
        ],
        "filters": [
          "仅当前主页面收录研究，去重ID",
          "年度图排除会议摘要、配套数据集、采购和基金",
          "期刊领域图另排除会议论文与预印本",
          "2026年截至2026-10-13收录"
        ],
        "metric_definitions": {
          "papers": "count of distinct catalog IDs within selected scope and year or journal domain",
          "share": "journal-domain papers divided by all journal papers in the selected scope"
        }
      }
    }
  ]
